<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Quản lý cửa hàng</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #f4f6fb;
      color: #263247;
    }
    header {
      background: #253b80;
      color: white;
      padding: 22px 7%;
    }
    header h1 { margin: 0 0 8px; }
    header p { margin: 0; }
    main { max-width: 1100px; margin: 28px auto; padding: 0 18px; }
    .stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 16px;
    }
    .card, .panel {
      background: white;
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 3px 12px #17255410;
    }
    .number { font-size: 28px; font-weight: bold; color: #253b80; }
    .panel { margin-top: 22px; }
    .toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin: 16px 0;
    }
    input, select, button {
      padding: 11px;
      border: 1px solid #d7ddeb;
      border-radius: 7px;
      font-size: 14px;
    }
    input { flex: 1; min-width: 180px; }
    button { cursor: pointer; border: 0; }
    .primary { background: #253b80; color: white; }
    .danger { background: #fee2e2; color: #b91c1c; }
    table { width: 100%; border-collapse: collapse; }
    th, td { padding: 13px 10px; text-align: left; border-bottom: 1px solid #edf0f5; }
    th { background: #f7f8fc; }
    .status { color: #15803d; background: #dcfce7; padding: 5px 8px; border-radius: 20px; }
    .hidden { color: #64748b; background: #e2e8f0; padding: 5px 8px; border-radius: 20px; }
    .actions { display: flex; gap: 6px; flex-wrap: wrap; }
    .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; }
    @media (max-width: 650px) {
      .table-wrap { overflow-x: auto; }
      th, td { white-space: nowrap; }
    }
  </style>
</head>
<body>
  <header>
    <h1>Quản lý cửa hàng</h1>
    <p>Khu vực người bán · Quản lý sản phẩm</p>
  </header>

  <main>
    <section class="stats">
      <div class="card">
        <p>Tổng sản phẩm</p>
        <div class="number" id="total">0</div>
      </div>
      <div class="card">
        <p>Đang bán</p>
        <div class="number" id="active">0</div>
      </div>
      <div class="card">
        <p>Đang ẩn</p>
        <div class="number" id="hiddenCount">0</div>
      </div>
    </section>

    <section class="panel">
      <h2 id="formTitle">Thêm sản phẩm</h2>
      <div class="form-grid">
        <input id="name" placeholder="Tên sản phẩm">
        <input id="category" placeholder="Danh mục">
        <input id="price" type="number" min="0" placeholder="Giá bán (VNĐ)">
        <input id="stock" type="number" min="0" placeholder="Số lượng tồn kho">
      </div>
      <div class="toolbar">
        <button class="primary" onclick="saveProduct()">Lưu sản phẩm</button>
        <button onclick="resetForm()">Làm mới</button>
      </div>
    </section>

    <section class="panel">
      <h2>Danh sách sản phẩm</h2>
      <div class="toolbar">
        <input id="search" placeholder="Tìm theo tên sản phẩm..." oninput="render()">
        <select id="filter" onchange="render()">
          <option value="all">Tất cả trạng thái</option>
          <option value="active">Đang bán</option>
          <option value="hidden">Đang ẩn</option>
        </select>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Tên sản phẩm</th>
              <th>Danh mục</th>
              <th>Giá bán</th>
              <th>Tồn kho</th>
              <th>Trạng thái</th>
              <th>Thao tác</th>
            </tr>
          </thead>
          <tbody id="productList"></tbody>
        </table>
      </div>
      <p id="emptyMessage">Chưa có sản phẩm. Em có thể thêm sản phẩm ở phía trên.</p>
    </section>
  </main>

  <script>
    let products = [];
    let editingId = null;
    let nextId = 1;

    function saveProduct() {
      const name = document.getElementById('name').value.trim();
      const category = document.getElementById('category').value.trim();
      const price = Number(document.getElementById('price').value);
      const stock = Number(document.getElementById('stock').value);

      if (!name || !category ||
          document.getElementById('price').value === '' ||
          document.getElementById('stock').value === '' ||
          price < 0 || stock < 0 || !Number.isFinite(price) ||
          !Number.isFinite(stock) || !Number.isInteger(stock)) {
        alert('Vui lòng nhập đầy đủ thông tin hợp lệ.');
        return;
      }

      if (editingId !== null) {
        const product = products.find(p => p.id === editingId);
        if (product) Object.assign(product, { name, category, price, stock });
      } else {
        products.push({ id: nextId++, name, category, price, stock, status: 'active' });
      }

      resetForm();
      render();
    }

    function editProduct(id) {
      const p = products.find(item => item.id === id);
      if (!p) return;
      editingId = id;
      document.getElementById('name').value = p.name;
      document.getElementById('category').value = p.category;
      document.getElementById('price').value = p.price;
      document.getElementById('stock').value = p.stock;
      document.getElementById('formTitle').textContent = 'Sửa sản phẩm';
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function resetForm() {
      editingId = null;
      ['name', 'category', 'price', 'stock'].forEach(id => {
        document.getElementById(id).value = '';
      });
      document.getElementById('formTitle').textContent = 'Thêm sản phẩm';
    }

    function toggleProduct(id) {
      const p = products.find(item => item.id === id);
      if (p) p.status = p.status === 'active' ? 'hidden' : 'active';
      render();
    }

    function deleteProduct(id) {
      if (!confirm('Em có chắc muốn xóa sản phẩm này không?')) return;
      products = products.filter(p => p.id !== id);
      if (editingId === id) resetForm();
      render();
    }

    function render() {
      const keyword = document.getElementById('search').value.trim().toLowerCase();
      const filter = document.getElementById('filter').value;
      const shown = products.filter(p =>
        p.name.toLowerCase().includes(keyword) &&
        (filter === 'all' || p.status === filter)
      );

      document.getElementById('productList').innerHTML = shown.map(p => `
        <tr>
          <td>${escapeHTML(p.name)}</td>
          <td>${escapeHTML(p.category)}</td>
          <td>${p.price.toLocaleString('vi-VN')} đ</td>
          <td>${p.stock}</td>
          <td><span class="${p.status}">${p.status === 'active' ? 'Đang bán' : 'Đang ẩn'}</span></td>
          <td><div class="actions">
            <button onclick="editProduct(${p.id})">Sửa</button>
            <button onclick="toggleProduct(${p.id})">${p.status === 'active' ? 'Ẩn' : 'Hiện'}</button>
            <button class="danger" onclick="deleteProduct(${p.id})">Xóa</button>
          </div></td>
        </tr>
      `).join('');

      document.getElementById('total').textContent = products.length;
      document.getElementById('active').textContent = products.filter(p => p.status === 'active').length;
      document.getElementById('hiddenCount').textContent = products.filter(p => p.status === 'hidden').length;
      document.getElementById('emptyMessage').hidden = shown.length > 0;
    }

    function escapeHTML(value) {
      return String(value).replace(/[&<>"']/g, c => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;',
        '"': '&quot;', "'": '&#39;'
      })[c]);
    }

    render();
  </script>
</body>
</html>
